[Unit]
Description=Tako web gateway
After=network.target
Requires=tako-sessiond.socket

[Service]
User=tako
Group=tako
ExecStart=/usr/bin/tako serve --config /etc/tako/config.toml
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/tako
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native

