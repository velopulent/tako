[Unit]
Description=Tako PAM session service

[Service]
ExecStart=/usr/bin/tako sessiond --socket /run/tako/session.sock
User=root
Group=tako-session
Restart=on-failure
RestartSec=2s
PrivateTmp=true
# Sessiond setuid-execs `tako bridge` as the authenticated user. That child
# inherits this unit's sandbox, so the unit must look like a login helper
# (cockpit-session), not like the network gateway. NoNewPrivileges,
# ProtectSystem=strict, ProtectControlGroups, and RestrictAddressFamilies
# block non-root bridge spawn or leave /home read-only.
ProtectSystem=true
ProtectHome=false
ProtectKernelTunables=true
ProtectKernelModules=true
UMask=0077
# Host PAM session stacks may record login events through wtmpdb. SQLite needs
# directory write access for its journal files.
ReadWritePaths=/var/log
ReadWritePaths=-/var/lib/wtmpdb
SystemCallArchitectures=native
