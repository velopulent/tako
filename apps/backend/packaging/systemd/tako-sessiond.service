[Unit]
Description=Tako PAM session service

[Service]
ExecStart=/usr/bin/tako sessiond --socket /run/tako/session.sock --config /etc/tako/config.toml
User=root
Group=tako-session
Restart=on-failure
RestartSec=2s
PrivateTmp=true
# Nothing a user runs inherits this sandbox. Each sign-in opens its PAM
# session in its own transient tako-login-*.service, which starts the user's
# bridge and terminals inside their logind session. Administrative work that
# must see the real host (files under /usr or /tmp, SELinux and AppArmor
# changes) runs in a transient tako-admin-*.service per administrative grant,
# and software updates in tako-update-*.service.
#
# /home stays visible for SSH key and account management, and
# NoNewPrivileges stays off because the administrative policy probe runs sudo
# as the signing-in user.
ProtectSystem=true
ProtectHome=false
ProtectKernelTunables=true
ProtectKernelModules=true
UMask=0077
SystemCallArchitectures=native
