{
  "name": "web",
  "projectType": "application",
  "sourceRoot": "apps/web/src",
  "tags": ["type:app", "scope:web"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": ["typecheck"],
      "cache": true,
      "outputs": ["{projectRoot}/dist"],
      "options": {
        "command": "bun run build",
        "cwd": "apps/web"
      }
    },
    "dev": {
      "executor": "nx:run-commands",
      "continuous": true,
      "options": {
        "command": "bun run dev",
        "cwd": "apps/web"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "command": "bun run typecheck",
        "cwd": "apps/web"
      }
    },
    "preview": {
      "executor": "nx:run-commands",
      "continuous": true,
      "options": {
        "command": "bun run preview",
        "cwd": "apps/web"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun run lint",
        "cwd": "apps/web"
      }
    },
    "format": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun run format",
        "cwd": "apps/web"
      }
    }
  }
}
