#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$root"

fail() {
    echo "package check: $*" >&2
    exit 1
}

for command_name in bun go goreleaser cc sha256sum systemd-analyze; do
    command -v "$command_name" >/dev/null 2>&1 || fail "missing command: $command_name"
done

[ "$(uname -s)" = Linux ] || fail "packaging supports Linux hosts only"
case "$(uname -m)" in
    x86_64|amd64) ;;
    *) fail "packaging currently supports amd64 hosts only" ;;
esac
[ "$(go env CGO_ENABLED)" = 1 ] || fail "CGO must be enabled"

probe_dir=$(mktemp -d)
trap 'rm -rf "$probe_dir"' EXIT HUP INT TERM
if ! printf '%s\n' '#include <security/pam_appl.h>' 'int main(void) { return PAM_SUCCESS; }' \
    | cc -x c - -lpam -o "$probe_dir/pam-probe" >/dev/null 2>&1; then
    fail "PAM headers or libpam linker files missing; install host PAM development package"
fi

goreleaser check

for script in apps/backend/packaging/scripts/deb/*.sh \
    apps/backend/packaging/scripts/rpm/*.sh \
    apps/backend/packaging/smoke-test.sh \
    apps/backend/packaging/lifecycle-test.sh; do
    sh -n "$script"
done

verify_log="$probe_dir/systemd-analyze.log"
if ! systemd-analyze verify \
    apps/backend/packaging/systemd/tako-sessiond.socket \
    apps/backend/packaging/systemd/tako-sessiond.service \
    apps/backend/packaging/systemd/tako.socket \
    apps/backend/packaging/systemd/tako.service 2>"$verify_log"; then
    # Restricted build sandboxes can block systemd's userdb credential sockets.
    # Ignore only those environment errors; unit diagnostics remain fatal.
    unexpected="$probe_dir/systemd-analyze-unexpected.log"
    grep -Ev 'Failed to turn off SO_PASSRIGHTS on user lookup socket|Failed to enable SO_PASSCRED on handoff timestamp socket' \
        "$verify_log" >"$unexpected" || true
    if [ -s "$unexpected" ]; then
        cat "$verify_log" >&2
        fail "systemd unit validation failed"
    fi
fi

apps/backend/packaging/scripts/test.sh
echo "Packaging checks passed"
