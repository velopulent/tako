#!/usr/bin/env bash
# Host-integrated development helper (Cockpit-style).
# Installs systemd units, PAM, and a checkout overlay so `tako serve` /
# `tako sessiond` run like production on the developer machine.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
PACKAGING="$ROOT/apps/backend/packaging"
BIN="$ROOT/bin/tako"
# systemd ProtectHome=true hides /home; ExecStart must live outside the checkout.
HOST_BIN="/usr/local/libexec/tako"
OVERLAY_SYNC="/usr/local/libexec/tako-overlay-sync"
SUDOERS_FILE="/etc/sudoers.d/tako-host"
DIST="$ROOT/apps/backend/internal/dashboard/dist"
OVERLAY="/run/tako/dashboard"
CONFIG_DIR="/etc/tako"
CONFIG_FILE="$CONFIG_DIR/config.toml"
UNIT_DIR="/etc/systemd/system"
HOST_BIN_FCONTEXT='/usr/local/libexec/tako'
DROPIN_MARKER="# Managed by tools/tako-host — do not edit by hand"

usage() {
  cat <<'EOF'
usage: tools/tako-host <command>

  setup      Install PAM, sysusers, tmpfiles, units, config, overlay (needs root)
  reload     Build bin/tako and restart systemd units
  start      Ensure units are active
  stop       Stop and disable Tako units
  uninstall  Stop units and remove host files installed by setup
  status     Show unit and overlay status
  watch      Build once, start host stack, then vite build --watch

Linux only. Prefer `bun run dev` (calls watch) after `sudo tools/tako-host setup`.
EOF
}

need_root() {
  if [[ "$(id -u)" -ne 0 ]]; then
    echo "tools/tako-host: this command needs root (try: sudo $0 $*)" >&2
    exit 1
  fi
}

user_home() {
  if [[ -n "${SUDO_USER:-}" && "$SUDO_USER" != root ]]; then
    getent passwd "$SUDO_USER" | cut -d: -f6
  else
    printf '%s\n' "${HOME:-}"
  fi
}

user_path() {
  local home="$1" path=""
  [[ -n "$home" && -d "$home/.bun/bin" ]] && path="$home/.bun/bin"
  [[ -n "${BUN_INSTALL:-}" && -d "$BUN_INSTALL/bin" ]] && path="${BUN_INSTALL}/bin${path:+:$path}"
  [[ -d "$home/.local/share/fnm/aliases/default/bin" ]] && path="$home/.local/share/fnm/aliases/default/bin${path:+:$path}"
  printf '%s:%s' "$path" "${PATH:-/usr/bin:/bin}"
}

run_as_user() {
  local home path
  home="$(user_home)"
  path="$(user_path "$home")"
  if [[ -n "${SUDO_USER:-}" && "$SUDO_USER" != root && "$(id -u)" -eq 0 ]]; then
    sudo -u "$SUDO_USER" -H env "HOME=$home" "PATH=$path" bash -c "$1"
  else
    env "HOME=$home" "PATH=$path" bash -c "$1"
  fi
}

detect_pam_source() {
  if [[ -f /etc/os-release ]]; then
    # shellcheck disable=SC1091
    . /etc/os-release
    case "${ID:-}:${ID_LIKE:-}" in
      debian:*|ubuntu:*|*debian*|*ubuntu*)
        echo "$PACKAGING/pam/tako.debian"
        return
        ;;
      fedora:*|rhel:*|centos:*|*fedora*|*rhel*)
        echo "$PACKAGING/pam/tako.redhat"
        return
        ;;
      arch:*|*arch*)
        echo "$PACKAGING/pam/tako"
        return
        ;;
    esac
  fi
  echo "$PACKAGING/pam/tako"
}

ensure_session_group() {
  if [[ -f "$PACKAGING/sysusers.d/tako.conf" ]]; then
    install -d -m 0755 /usr/lib/sysusers.d
    install -m 0644 "$PACKAGING/sysusers.d/tako.conf" /usr/lib/sysusers.d/tako.conf
    systemd-sysusers /usr/lib/sysusers.d/tako.conf
  fi
  if ! getent group tako-session >/dev/null; then
    groupadd --system tako-session
  fi
}

install_unit() {
  local name="$1"
  install -m 0644 "$PACKAGING/systemd/$name" "$UNIT_DIR/$name"
}

write_dropin() {
  local unit="$1"
  local body="$2"
  local dir="$UNIT_DIR/${unit}.d"
  mkdir -p "$dir"
  cat >"$dir/10-tako-host.conf" <<EOF
$DROPIN_MARKER
[Service]
$body
EOF
}

install_host_binary() {
  if [[ ! -x "$BIN" ]]; then
    echo "tools/tako-host: missing $BIN — build first (bun nx build backend)" >&2
    exit 1
  fi
  install -d -m 0755 "$(dirname "$HOST_BIN")"
  install -m 0755 "$BIN" "$HOST_BIN"
  label_host_binary
}

label_host_binary() {
  # install(1) from a checkout under /home keeps user_home_t. Pin bin_t in the
  # file-context database so restorecon survives relabel, then apply it.
  if command -v semanage >/dev/null 2>&1; then
    if ! semanage fcontext -l 2>/dev/null | grep -Fq "$HOST_BIN_FCONTEXT"; then
      semanage fcontext -a -t bin_t "$HOST_BIN_FCONTEXT" 2>/dev/null || true
    fi
  fi
  if command -v restorecon >/dev/null 2>&1; then
    restorecon -F "$HOST_BIN" 2>/dev/null || true
  elif command -v chcon >/dev/null 2>&1; then
    chcon -t bin_t "$HOST_BIN" 2>/dev/null || true
  fi
}

write_overlay_sync() {
  cat >"$OVERLAY_SYNC" <<EOF
#!/bin/bash
# Generated by tools/tako-host. Copies checkout dist into /run/tako/dashboard.
set -euo pipefail
DIST=$(printf '%q' "$DIST")
OVERLAY=$(printf '%q' "$OVERLAY")
mkdir -p "\$OVERLAY"
if command -v rsync >/dev/null 2>&1; then
  rsync -rlt --delete --chmod=u=rwX,go=rX "\$DIST"/ "\$OVERLAY"/
else
  find "\$OVERLAY" -mindepth 1 -delete 2>/dev/null || true
  cp -r --no-preserve=mode,ownership,context,xattr "\$DIST"/. "\$OVERLAY"/
  chmod -R u=rwX,go=rX "\$OVERLAY"
fi
if command -v restorecon >/dev/null 2>&1; then
  restorecon -RF "\$OVERLAY" /run/tako 2>/dev/null || true
fi
EOF
  if command -v semanage >/dev/null 2>&1; then
    if ! semanage fcontext -l 2>/dev/null | grep -Fq "$OVERLAY_SYNC"; then
      semanage fcontext -a -t bin_t "$OVERLAY_SYNC" 2>/dev/null || true
    fi
  fi
  chmod 0755 "$OVERLAY_SYNC"
  if command -v restorecon >/dev/null 2>&1; then
    restorecon -F "$OVERLAY_SYNC" 2>/dev/null || true
  elif command -v chcon >/dev/null 2>&1; then
    chcon -t bin_t "$OVERLAY_SYNC" 2>/dev/null || true
  fi

  local user="${SUDO_USER:-}"
  if [[ -n "$user" && "$user" != root ]]; then
    cat >"$SUDOERS_FILE" <<EOF
# Managed by tools/tako-host
$user ALL=(root) NOPASSWD: $OVERLAY_SYNC
EOF
    chmod 0440 "$SUDOERS_FILE"
    if command -v visudo >/dev/null 2>&1 && ! visudo -cf "$SUDOERS_FILE" >/dev/null 2>&1; then
      rm -f "$SUDOERS_FILE"
    fi
  fi
}

sync_overlay() {
  systemd-tmpfiles --create /etc/tmpfiles.d/tako.conf 2>/dev/null || true
  mkdir -p "$DIST"
  if [[ -x "$OVERLAY_SYNC" ]]; then
    "$OVERLAY_SYNC"
    return
  fi
  mkdir -p "$OVERLAY"
  if command -v rsync >/dev/null 2>&1; then
    rsync -rlt --delete --chmod=u=rwX,go=rX "$DIST"/ "$OVERLAY"/
  else
    find "$OVERLAY" -mindepth 1 -delete 2>/dev/null || true
    cp -r --no-preserve=mode,ownership,context,xattr "$DIST"/. "$OVERLAY"/
    chmod -R u=rwX,go=rX "$OVERLAY"
  fi
  if command -v restorecon >/dev/null 2>&1; then
    restorecon -RF "$OVERLAY" /run/tako 2>/dev/null || true
  fi
}

run_overlay_sync() {
  if [[ "$(id -u)" -eq 0 ]]; then
    sync_overlay
    return
  fi
  if [[ -x "$OVERLAY_SYNC" ]] && sudo -n "$OVERLAY_SYNC" 2>/dev/null; then
    return
  fi
  sudo "$ROOT/tools/tako-host" _sync_overlay
}

remove_legacy_sync_units() {
  # Old host-dev used a systemd path unit that watched /home and failed.
  systemctl stop tako-dashboard-sync.path tako-dashboard-sync.service 2>/dev/null || true
  systemctl disable tako-dashboard-sync.path tako-dashboard-sync.service 2>/dev/null || true
  rm -f "$UNIT_DIR/tako-dashboard-sync.service" "$UNIT_DIR/tako-dashboard-sync.path"
  systemctl reset-failed tako-dashboard-sync.service tako-dashboard-sync.path 2>/dev/null || true
}

write_host_dropins() {
  # Binary lives outside /home (ProtectHome). Dashboard is copied to /run/tako,
  # not bind-mounted from the checkout.
  write_dropin tako.service "ExecStart=
ExecStart=$HOST_BIN serve --config $CONFIG_FILE
Environment=TAKO_DASHBOARD_DIR=$OVERLAY"

  write_dropin tako-sessiond.service "ExecStart=
ExecStart=$HOST_BIN sessiond --socket /run/tako/session.sock --config $CONFIG_FILE"
}

cmd_setup() {
  need_root setup

  ensure_session_group

  install -d -m 0755 "$CONFIG_DIR"
  install -m 0644 "$(detect_pam_source)" /etc/pam.d/tako
  install -m 0644 "$PACKAGING/tmpfiles.d/tako.conf" /etc/tmpfiles.d/tako.conf
  systemd-tmpfiles --create /etc/tmpfiles.d/tako.conf

  if [[ -d /usr/share/polkit-1/actions ]] && [[ -f "$PACKAGING/polkit/org.velopulent.tako.policy" ]]; then
    install -m 0644 "$PACKAGING/polkit/org.velopulent.tako.policy" \
      /usr/share/polkit-1/actions/org.velopulent.tako.policy
  fi

  install_unit tako.service
  install_unit tako.socket
  install_unit tako-sessiond.service
  install_unit tako-sessiond.socket

  if [[ ! -f "$CONFIG_FILE" ]]; then
    cat >"$CONFIG_FILE" <<EOF
[server]
address = "127.0.0.1:9090"
data_dir = "/var/lib/tako"
session_socket = "/run/tako/session.sock"
allowed_origin = "https://localhost:9090, https://127.0.0.1:9090"

[monitoring]
default_interval = "1m"
history_retention = "24h"

[admin]
idle_timeout = "5m"
EOF
  fi
  chown root:tako-session "$CONFIG_FILE"
  chmod 0640 "$CONFIG_FILE"

  install -d -m 0700 /var/lib/tako

  # Ensure the checkout dist exists so the bind path is valid at first start.
  mkdir -p "$DIST"
  if [[ ! -f "$DIST/index.html" ]]; then
    printf '%s\n' '<!doctype html><title>Tako</title><p>Build the dashboard (bun run dev).</p>' >"$DIST/index.html"
  fi

  if [[ ! -x "$BIN" ]]; then
    echo "Building $BIN…"
    build_binary
  fi
  install_host_binary
  write_host_dropins
  write_overlay_sync
  sync_overlay
  remove_legacy_sync_units

  systemctl daemon-reload
  systemd-tmpfiles --create /etc/tmpfiles.d/tako.conf
  systemctl enable --now tako-sessiond.socket
  systemctl enable --now tako.socket
  systemctl reset-failed tako.service 2>/dev/null || true
  systemctl enable --now tako.service

  echo "https://127.0.0.1:9090"
}

build_binary() {
  run_as_user "cd '$ROOT' && command -v bun >/dev/null || { echo 'tools/tako-host: bun not found (install from https://bun.sh)' >&2; exit 1; }; bun nx build backend"
}

refresh_overlay() {
  mkdir -p "$DIST"
  if [[ "$(id -u)" -eq 0 ]]; then
    sync_overlay
  fi
}

units_installed() {
  [[ -f "$UNIT_DIR/tako.service" ]] && [[ -f "$UNIT_DIR/tako-sessiond.socket" ]]
}

cmd_reload() {
  if ! units_installed; then
    echo "tools/tako-host: host stack not installed. Run: sudo tools/tako-host setup" >&2
    exit 1
  fi
  build_binary
  if [[ "$(id -u)" -eq 0 ]]; then
    refresh_overlay
    install_host_binary
    write_host_dropins
    write_overlay_sync
    remove_legacy_sync_units
    systemctl daemon-reload
    systemctl reset-failed tako.service 2>/dev/null || true
    systemctl restart tako-sessiond.socket tako.socket tako.service
  else
    sudo "$ROOT/tools/tako-host" _restart
  fi
}

cmd_restart_as_root() {
  need_root _restart
  refresh_overlay
  install_host_binary
  write_host_dropins
  write_overlay_sync
  remove_legacy_sync_units
  systemctl daemon-reload
  systemctl reset-failed tako.service 2>/dev/null || true
  systemctl restart tako-sessiond.socket tako.socket tako.service
}

cmd_start() {
  if ! units_installed; then
    echo "tools/tako-host: host stack not installed. Run: sudo tools/tako-host setup" >&2
    exit 1
  fi
  if [[ ! -x "$BIN" ]]; then
    build_binary
  fi
  if [[ "$(id -u)" -eq 0 ]]; then
    refresh_overlay
    systemctl start tako-sessiond.socket tako.socket tako.service
  else
    sudo "$ROOT/tools/tako-host" _start_root
  fi
}

cmd_start_root() {
  need_root _start_root
  refresh_overlay
  if [[ -x "$BIN" ]]; then
    install_host_binary
  fi
  systemd-tmpfiles --create /etc/tmpfiles.d/tako.conf 2>/dev/null || true
  systemctl reset-failed tako.service 2>/dev/null || true
  systemctl start tako-sessiond.socket tako.socket tako.service
}

cmd_stop() {
  if [[ "$(id -u)" -ne 0 ]]; then
    sudo "$ROOT/tools/tako-host" stop
    return
  fi
  remove_legacy_sync_units
  systemctl stop tako.service tako.socket tako-sessiond.service tako-sessiond.socket 2>/dev/null || true
  systemctl disable tako.service tako.socket tako-sessiond.service tako-sessiond.socket 2>/dev/null || true
}

remove_overlay() {
  if [[ -L "$OVERLAY" ]]; then
    rm -f "$OVERLAY"
    return
  fi
  if [[ -d "$OVERLAY" ]] && mountpoint -q "$OVERLAY" 2>/dev/null; then
    umount "$OVERLAY" || umount -l "$OVERLAY" || {
      echo "tools/tako-host: could not unmount $OVERLAY; leaving it in place" >&2
      return
    }
  fi
  if [[ -d "$OVERLAY" ]]; then
    if mountpoint -q "$OVERLAY" 2>/dev/null; then
      echo "tools/tako-host: $OVERLAY still mounted; not removing" >&2
      return
    fi
    rm -rf "$OVERLAY"
  elif [[ -e "$OVERLAY" ]]; then
    rm -f "$OVERLAY"
  fi
}

cmd_uninstall() {
  need_root uninstall
  remove_legacy_sync_units
  systemctl stop tako.service tako.socket tako-sessiond.service tako-sessiond.socket 2>/dev/null || true
  systemctl disable tako.service tako.socket tako-sessiond.service tako-sessiond.socket 2>/dev/null || true
  rm -f "$UNIT_DIR/tako.service" "$UNIT_DIR/tako.socket" \
    "$UNIT_DIR/tako-sessiond.service" "$UNIT_DIR/tako-sessiond.socket"
  rm -rf "$UNIT_DIR/tako.service.d" "$UNIT_DIR/tako-sessiond.service.d"
  rm -f /etc/tmpfiles.d/tako.conf /usr/lib/sysusers.d/tako.conf /etc/pam.d/tako
  rm -f /usr/share/polkit-1/actions/org.velopulent.tako.policy
  rm -f "$HOST_BIN" "$OVERLAY_SYNC" "$SUDOERS_FILE"
  if command -v semanage >/dev/null 2>&1; then
    semanage fcontext -d "$HOST_BIN_FCONTEXT" 2>/dev/null || true
    semanage fcontext -d "$OVERLAY_SYNC" 2>/dev/null || true
  fi
  remove_overlay
  systemctl daemon-reload
}

cmd_status() {
  echo "checkout: $BIN$([ -x "$BIN" ] && echo ' (present)' || echo ' (missing)')"
  echo "host bin: $HOST_BIN$([ -x "$HOST_BIN" ] && echo ' (present)' || echo ' (missing)')"
  echo "dist:     $DIST$([ -f "$DIST/index.html" ] && echo ' (ready)' || echo ' (missing index.html)')"
  echo "overlay:  $OVERLAY (copy of dist, restorecon)"
  if units_installed; then
    systemctl --no-pager --full status tako.service tako-sessiond.socket 2>/dev/null || true
  else
    echo "units: not installed (sudo tools/tako-host setup)"
  fi
}

cmd_watch() {
  if ! units_installed; then
    echo "tools/tako-host: host stack not installed. Run: sudo tools/tako-host setup" >&2
    exit 1
  fi
  build_binary
  cmd_start
  run_overlay_sync
  watch_overlay_loop &
  local watch_pid=$!
  trap 'kill "$watch_pid" 2>/dev/null || true' EXIT
  run_as_user "cd '$ROOT/apps/dashboard' && bun x vite build --watch"
}

watch_overlay_loop() {
  local last="" now
  while true; do
    now="$(stat -c %Y "$DIST/index.html" 2>/dev/null || echo 0)"
    if [[ "$now" != "$last" ]]; then
      last=$now
      run_overlay_sync || true
    fi
    sleep 0.5
  done
}

main() {
  local cmd="${1:-}"
  case "$cmd" in
    setup) cmd_setup ;;
    reload) cmd_reload ;;
    start) cmd_start ;;
    stop) cmd_stop ;;
    uninstall) cmd_uninstall ;;
    status) cmd_status ;;
    watch) cmd_watch ;;
    _restart) cmd_restart_as_root ;;
    _start_root) cmd_start_root ;;
    _sync_overlay)
      need_root _sync_overlay
      sync_overlay
      ;;
    -h|--help|help|"") usage; [[ -n "$cmd" ]] || exit 2 ;;
    *)
      echo "unknown command: $cmd" >&2
      usage
      exit 2
      ;;
  esac
}

main "$@"
