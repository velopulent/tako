#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$root"

target_id="${TAKO_PACKAGE_TARGET:-all}"

build_config_dir=$(mktemp -d)
trap 'rm -rf "$build_config_dir"' EXIT HUP INT TERM
build_config="$build_config_dir/.goreleaser.yaml"

TAKO_PACKAGE_TARGET="$target_id" ./tools/package-check

TAKO_PACKAGE_TARGET="$target_id" TAKO_BUILD_CONFIG="$build_config" bun -e '
const manifest = await Bun.file("apps/backend/packaging/targets.json").json();
const requested = process.env.TAKO_PACKAGE_TARGET;
const hostArch = (await Bun.$`go env GOARCH`.text()).trim();
const targets = requested === "all"
  ? manifest.targets.filter((value) => value.goarch === hostArch)
  : [manifest.targets.find((value) => value.id === requested)].filter(Boolean);
if (targets.length === 0) {
  throw new Error(requested === "all"
    ? `no packaging targets match host GOARCH=${hostArch}`
    : `unknown TAKO_PACKAGE_TARGET: ${requested}`);
}
const buildIds = new Set(targets.map((value) => value.build_id));
const packageIds = new Set(targets.map((value) => value.package_id));
const config = Bun.YAML.parse(await Bun.file(".goreleaser.yaml").text());
config.builds = config.builds.filter((build) => buildIds.has(build.id));
config.nfpms = config.nfpms
  .map((pkg) => ({ ...pkg, ids: (pkg.ids ?? []).filter((id) => buildIds.has(id)) }))
  .filter((pkg) => pkg.ids.length > 0);
if (config.builds.length !== buildIds.size || config.nfpms.length !== packageIds.size) {
  throw new Error(`incomplete GoReleaser selection for ${targets.map((value) => value.id).join(", ")}`);
}
await Bun.write(process.env.TAKO_BUILD_CONFIG, Bun.YAML.stringify(config));
'

goreleaser release --snapshot --clean --config "$build_config"

TAKO_PACKAGE_TARGET="$target_id" bun -e '
const manifest = await Bun.file("apps/backend/packaging/targets.json").json();
const requested = process.env.TAKO_PACKAGE_TARGET;
const hostArch = (await Bun.$`go env GOARCH`.text()).trim();
const targets = requested === "all"
  ? manifest.targets.filter((value) => value.goarch === hostArch)
  : [manifest.targets.find((value) => value.id === requested)].filter(Boolean);
if (targets.length === 0) {
  throw new Error(requested === "all"
    ? `no packaging targets match host GOARCH=${hostArch}`
    : `unknown TAKO_PACKAGE_TARGET: ${requested}`);
}
const data = await Bun.file("dist/artifacts.json").json();
const packages = data.filter((artifact) => artifact.type === "Linux Package");
const binaries = data.filter((artifact) => artifact.type === "Binary");
const extensions = { deb: ".deb", rpm: ".rpm", archlinux: ".pkg.tar.zst" };
if (packages.length !== targets.length) throw new Error(`expected ${targets.length} package artifacts, found ${packages.length}`);
if (binaries.length !== targets.length) throw new Error(`expected ${targets.length} binary artifacts, found ${binaries.length}`);
for (const target of targets) {
  const matchingPackages = packages.filter((artifact) => artifact.extra?.ID === target.package_id && artifact.goarch === target.goarch);
  const matchingBinaries = binaries.filter((artifact) => artifact.extra?.ID === target.build_id && artifact.goarch === target.goarch);
  if (matchingPackages.length !== 1) throw new Error(`${target.id}: expected one package artifact, found ${matchingPackages.length}`);
  if (matchingBinaries.length !== 1) throw new Error(`${target.id}: expected one binary artifact, found ${matchingBinaries.length}`);
  const artifact = matchingPackages[0];
  if (artifact.goos !== "linux" || artifact.goarch !== target.goarch) throw new Error(`${target.id}: unexpected package target ${artifact.target}`);
  if (artifact.extra.Format !== target.package_format) throw new Error(`${target.id}: package format ${artifact.extra.Format} does not match ${target.package_format}`);
  if (!artifact.name.endsWith(`_${target.package_name}${extensions[target.package_format]}`)) throw new Error(`${target.id}: package name ${artifact.name} does not match manifest`);
  const binary = matchingBinaries[0];
  if (binary.goos !== "linux" || binary.goarch !== target.goarch) throw new Error(`${target.id}: unexpected binary target ${binary.target}`);
  const paths = new Set((artifact.extra.Files ?? []).map((file) => file.dst));
  for (const path of manifest.build.required_files) if (!paths.has(path)) throw new Error(`${target.id}: package is missing ${path}`);
  const branding = [...paths].filter((path) => path.startsWith(`${manifest.build.branding_directory}/`));
  if (branding.length !== 1 || branding[0] !== `${manifest.build.branding_directory}/${target.branding}.png`) throw new Error(`${target.id}: package has the wrong branding files`);
  const pam = (artifact.extra.Files ?? []).find((file) => file.dst === manifest.build.pam_destination);
  if (!pam || !pam.src.endsWith(`/pam/${target.pam_source}`)) throw new Error(`${target.id}: package has the wrong PAM policy`);
}
if (!(await Bun.file("dist/checksums.txt").exists())) throw new Error("missing dist/checksums.txt");
console.log(`validated ${targets.length} package artifacts for ${requested}`);
'

(cd dist && sha256sum --check checksums.txt)
echo "Packages written to dist/ for $target_id"
