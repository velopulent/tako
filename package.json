{
  "name": "tako",
  "private": true,
  "version": "0.0.1",
  "packageManager": "bun@1.4.0",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "./tools/tako-host watch",
    "dev:ui": "nx run-many -t dev --projects=backend,dashboard --parallel=2",
    "web:dev": "nx run web:dev",
    "web:build": "nx run web:build",
    "web:preview": "nx run web:preview",
    "web:typecheck": "nx run web:typecheck",
    "web:lint": "nx run web:lint",
    "web:format": "nx run web:format",
    "web:check": "nx run-many -t lint,typecheck --projects=web",
    "build": "nx build backend",
    "package": "./tools/package",
    "package:check": "./tools/package-check",
    "test:packaging": "./apps/backend/packaging/scripts/test.sh",
    "test": "nx run-many -t test,typecheck",
    "lint": "nx run-many -t lint",
    "format": "nx run-many -t format",
    "typecheck": "nx typecheck dashboard",
    "race": "nx race backend",
    "graph": "nx graph"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@nx/vite": "^23.2.0",
    "nx": "^23.2.0"
  }
}
